  "keyFeatures": [
    "HMAC SHA-256 webhook signature verification built-in",
    "Auto-refreshing GitHub App installation tokens via ghinstallation",
    "Pre-authenticated go-github client available in every handler context",
    "Event-driven handler API: On, OnMany, OnAny, OnError",
    "One-click GitHub App registration via manifest flow setup wizard",
    "Repo-level YAML/JSON config loading with _extends inheritance",
    "Embeddable as net/http middleware in existing servers",
    "GitHub Actions support via RunAction()",
    "Webhook proxy (Smee.io) client for local development",
    "Environment variable and .env file configuration helpers"
  ],
  "publicApiSurface": [
    "probot.New(o Options, defaults ...func(*Options)) (*Probot, error)",
    "probot.Defaults(o Options) func(*Options)",
    "probot.OptionsFromEnv() (Options, error)",
    "probot.LoadEnvFile(path string) error",
    "(*Probot).On(eventName string, fn HandlerFunc)",
    "(*Probot).OnMany(eventNames []string, fn HandlerFunc)",
    "(*Probot).OnAny(fn HandlerFunc)",
    "(*Probot).OnError(fn ErrorHandlerFunc)",
    "(*Probot).Load(fns ...ApplicationFunc) error",
    "(*Probot).Auth(installationID ...int64) (*github.Client, error)",
    "(*Probot).Receive(event WebhookEvent) error",
    "(*Probot).RunAction() error",
    "(*Probot).WebhookHandler() http.HandlerFunc",
    "(*Probot).WebhookMiddleware() func(http.Handler) http.Handler",
    "(*Probot).Handler(next ...http.Handler) http.Handler",
    "probot.NewServer(o ServerOptions) *Server",
    "(*Server).Start() error",
    "(*Server).Stop() error",
    "(*Server).Handler() http.Handler",
    "(*Context).GitHub() *github.Client",
    "(*Context).Octokit() *github.Client",
    "(*Context).Issue() (IssueParams, error)",
    "(*Context).Repo() (Repo, error)",
    "(*Context).PullRequest() (PullRequestParams, error)",
    "(*Context).Config(fileName string, defaults ...map[string]any) (map[string]any, error)",
    "(*Context).ParseInto(v any) error",
    "(*Context).Payload() map[string]any",
    "(*Context).Log() zerolog.Logger",
    "(*Context).IsBot() bool",
    "(*Context).Name() string",
    "(*Context).ID() string",
    "probot.VerifyGitHubSignature(secret, payload, signature string) error"
  ]
}
