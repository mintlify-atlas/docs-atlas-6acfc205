{
  "projectType": "sdk-library",
  "projectName": "probot-go",
  "projectDescription": "A Go port of Probot — a framework for building GitHub Apps with built-in webhook validation, auto-refreshing installation auth, and an event-driven handler API.",
  "theme": "luma",
  "primaryColor": "#ffae04",
  "lightColor": "#000000",
  "darkColor": "#fcfcfc",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
